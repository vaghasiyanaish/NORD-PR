<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>BookMyShow | Movies - New UI</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #0f0f0f;
            color: #fff;
            font-family: "Poppins", sans-serif;
        }

        .navbar {
            background: #1a1a1a !important;
        }

        .search-box input {
            background: #2a2a2a;
            border: none;
            color: #fff;
        }

        .movie-card {
            background: #1b1b1b;
            border-radius: 16px;
            overflow: hidden;
            transition: 0.3s ease;
        }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 18px rgba(255, 0, 0, 0.3);
        }

        .movie-card img {
            height: 350px;
            object-fit: cover;
        }

        .add-form-card {
            background: #1b1b1b;
            border-radius: 20px;
        }

        .add-form-card input,
        .add-form-card textarea {
            background: #2a2a2a;
            border: none;
            color: #fff;
        }

        .btn-danger {
            background: linear-gradient(45deg, #ff1e1e, #ff5757);
            border: none;
        }

        footer {
            background: #111;
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <nav class="navbar navbar-expand-lg py-3 shadow-sm">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            <a class="navbar-brand text-white fw-bold fs-4">BMS</a>

            <div class="search-box flex-grow-1 mx-4">
                <input class="form-control rounded-pill py-2 px-3" placeholder="Search Movies, Events, Plays...">
            </div>

            <div class="d-flex gap-2">
                <select class="form-select form-select-sm bg-dark text-white border-0 rounded-pill px-3">
                    <option>Surat</option>
                    <option>Mumbai</option>
                    <option>Delhi</option>
                </select>
                <button class="btn btn-danger rounded-pill px-3">Sign In</button>
            </div>
        </div>
    </nav>

    <!-- CAROUSEL -->
    <div class="container mt-4">
        <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner rounded-4 shadow">
                <div class="carousel-item active">
                    <img src="https://assets-in.bmscdn.com/promotions/cms/creatives/1706162424953_pets.jpg" class="d-block w-100">
                </div>
                <div class="carousel-item">
                    <img src="https://assets-in.bmscdn.com/promotions/cms/creatives/1706312082608_kalki.jpg" class="d-block w-100">
                </div>
                <div class="carousel-item">
                    <img src="https://assets-in.bmscdn.com/promotions/cms/creatives/1706431125398_banner.jpg" class="d-block w-100">
                </div>
            </div>
        </div>
    </div>

    <!-- ADD MOVIE FORM -->
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="add-form-card p-4 shadow-lg">
                    <h3 class="text-center fw-bold mb-4">Add New Movie</h3>

                    <form action="/add" method="post" enctype="multipart/form-data">
                        <input class="form-control mb-3" name="title" placeholder="Movie Title" required>
                        <textarea class="form-control mb-3" name="description" rows="3" placeholder="Movie Description"></textarea>
                        <input class="form-control mb-3" name="genre" placeholder="Genre">
                        <input class="form-control mb-3" type="number" step="0.1" name="rating" placeholder="Rating (0-10)">
                        <input class="form-control mb-3" name="director" placeholder="Director">
                        <input class="form-control mb-3" type="number" name="releaseYear" placeholder="Release Year">
                        <input class="form-control mb-4" type="file" name="poster">

                        <button class="btn btn-danger w-100 rounded-pill fw-semibold py-2">Add Movie</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- MOVIE LIST -->
    <div class="container mt-5">
        <h2 class="fw-bold mb-4">Now Showing</h2>

        <div class="row">
            <% allMovies.forEach(movie => { %>
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="movie-card shadow">
                        <img src="<%= movie.poster %>" class="w-100">

                        <div class="p-3">
                            <h5 class="fw-bold text-white"><%= movie.title %></h5>
                            <p class="text-secondary small mb-1"><%= movie.genre %></p>
                            <p class="text-warning fw-semibold mb-2"><i class="bi bi-star-fill"></i> <%= movie.rating %> / 10</p>

                            <div class="d-flex gap-2">
                                <a href="/edit/<%= movie.id %>" class="btn btn-outline-warning w-50 py-1">Edit</a>
                                <a href="/delete/<%= movie.id %>" class="btn btn-outline-danger w-50 py-1">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <footer class="mt-5 py-4 text-center text-secondary">
        © 2025 BookMyShow Clone — New UI Version
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
