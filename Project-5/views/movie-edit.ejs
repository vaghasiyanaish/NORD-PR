<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Movie — New UI</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #0f0f0f;
            color: #fff;
            font-family: "Poppins", sans-serif;
        }

        .navbar {
            background: #1a1a1a !important;
        }

        .search-box input {
            background: #2a2a2a;
            border: none;
            color: #fff;
        }

        .edit-form-card {
            background: #1b1b1b;
            border-radius: 20px;
        }

        .edit-form-card input,
        .edit-form-card textarea {
            background: #2a2a2a;
            border: none;
            color: #fff;
        }

        .btn-danger {
            background: linear-gradient(45deg, #ff1e1e, #ff5757);
            border: none;
        }

        footer {
            background: #111;
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <nav class="navbar navbar-expand-lg py-3 shadow-sm">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            <a class="navbar-brand text-white fw-bold fs-4" href="/">BMS</a>

            <div class="search-box flex-grow-1 mx-4">
                <input class="form-control rounded-pill py-2 px-3" placeholder="Search Movies, Events, Plays...">
            </div>

            <div class="d-flex gap-2">
                <select class="form-select form-select-sm bg-dark text-white border-0 rounded-pill px-3">
                    <option>Surat</option>
                    <option>Mumbai</option>
                    <option>Delhi</option>
                </select>
                <button class="btn btn-danger rounded-pill px-3">Sign In</button>
            </div>
        </div>
    </nav>

    <!-- EDIT MOVIE FORM -->
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="edit-form-card p-4 shadow-lg">
                    <h3 class="text-center fw-bold mb-4">Edit Movie</h3>

                    <form action="/update/<%= movie.id %>" method="post" enctype="multipart/form-data">

                        <input class="form-control mb-3" name="title" value="<%= movie.title %>" placeholder="Movie Title" required>

                        <textarea class="form-control mb-3" name="description" rows="3" placeholder="Movie Description"><%= movie.description %></textarea>

                        <input class="form-control mb-3" name="genre" value="<%= movie.genre %>" placeholder="Genre">

                        <input class="form-control mb-3" type="number" step="0.1" name="rating" value="<%= movie.rating %>" placeholder="Rating (0-10)">

                        <input class="form-control mb-3" name="director" value="<%= movie.director %>" placeholder="Director">

                        <input class="form-control mb-3" type="number" name="releaseYear" value="<%= movie.releaseYear %>" placeholder="Release Year">

                        <label class="text-secondary small mb-1">Upload New Poster (Optional)</label>
                        <input class="form-control mb-4" type="file" name="poster">

                        <button class="btn btn-danger w-100 rounded-pill fw-semibold py-2">Update Movie</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <footer class="mt-5 py-4 text-center text-secondary">© 2025 BookMyShow Clone — New UI Version</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
