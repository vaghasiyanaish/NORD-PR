<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Book - Neo Theme</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: "Poppins", sans-serif; }

        body { background: linear-gradient(135deg, #ffe8d6, #fcd2af); min-height: 100vh; color: #3a2e2a; }

        header {
            background: #6a040f;
            padding: 25px;
            font-size: 2.5rem;
            text-align: center;
            font-weight: 700;
            color: white;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        }

        .form-container {
            max-width: 900px;
            margin: 50px auto;
            padding: 35px;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
        }

        .form-title {
            text-align: center;
            font-size: 1.9rem;
            margin-bottom: 20px;
            color: #6a040f;
            font-weight: 700;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .form-group label {
            font-size: 1rem;
            font-weight: 600;
            color: #5b4636;
            margin-bottom: 8px;
            display: block;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 14px;
            background: #fff7f0;
            border: 1px solid #c5b5a1;
            border-radius: 12px;
            transition: .3s;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            background: #ffffff;
            border-color: #9d0208;
            box-shadow: 0 0 8px rgba(157, 2, 8, 0.3);
            outline: none;
        }

        textarea { height: 130px; resize: none; }

        .btn {
            width: 100%;
            margin-top: 20px;
            padding: 15px;
            background: #9d0208;
            color: white;
            border: none;
            font-size: 1.15rem;
            font-weight: 700;
            border-radius: 12px;
            cursor: pointer;
            transition: .3s;
        }

        .btn:hover { background: #780000; transform: translateY(-2px); }

        /* Table */
        .list-table {
            width: 95%;
            margin: 50px auto;
            background: white;
            border-radius: 15px;
            border-collapse: collapse;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        .list-table th {
            padding: 16px;
            background: #6a040f;
            color: white;
            font-size: 0.95rem;
        }

        .list-table td {
            padding: 16px;
            font-size: 0.95rem;
            border-bottom: 1px solid #ecdcd1;
            color: #4b3b33;
        }

        .list-table tr:hover { background: #fff1e6; }

        .action-btn {
            padding: 8px 12px;
            font-size: 0.85rem;
            border-radius: 8px;
            border: none;
            color: white;
            cursor: pointer;
            font-weight: 600;
        }

        .edit { background: #6a040f; }
        .edit:hover { background: #54030c; }

        .delete { background: #d00000; }
        .delete:hover { background: #9d0208; }

        footer {
            margin-top: 60px;
            background: #6a040f;
            color: white;
            text-align: center;
            padding: 18px;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
        }

    </style>
</head>

<body>
    <header><i class="fas fa-book"></i> Bookstore Management</header>

    <div class="form-container">
        <h2 class="form-title">Add New Book</h2>

        <form action="/add-book" method="post">
            <div class="form-grid">
                <div class="form-group">
                    <label>Title</label>
                    <input type="text" name="title" required />
                </div>

                <div class="form-group">
                    <label>Author</label>
                    <input type="text" name="author" required />
                </div>

                <div class="form-group">
                    <label>Genre</label>
                    <input type="text" name="genre" required />
                </div>

                <div class="form-group">
                    <label>Price</label>
                    <input type="number" name="price" required />
                </div>
            </div>

            <div class="form-group" style="margin-top:20px;">
                <label>Description</label>
                <textarea name="description" required></textarea>
            </div>

            <div class="form-grid" style="margin-top:20px;">
                <div class="form-group">
                    <label>Publisher</label>
                    <input type="text" name="publisher" required />
                </div>

                <div class="form-group">
                    <label>Published Year</label>
                    <input type="number" name="year" required />
                </div>
            </div>

            <button class="btn">Add Book</button>
        </form>
    </div>

    <table class="list-table">
        <tr>
            <th>#</th>
            <th>Book</th>
            <th>Author</th>
            <th>Genre</th>
            <th>Price</th>
            <th>Description</th>
            <th>Publisher</th>
            <th>Year</th>
            <th>Action</th>
        </tr>

        <% books.forEach((book, index)=> { %>
        <tr>
            <td><%= index + 1 %></td>
            <td><%= book.title %></td>
            <td><%= book.author %></td>
            <td><%= book.genre %></td>
            <td>₹<%= book.price.toFixed(2) %></td>
            <td><%= book.description %></td>
            <td><%= book.publisher %></td>
            <td><%= book.year %></td>
            <td>
                <a href="/editbook/<%= book.id %>"><button class="action-btn edit">Edit</button></a>
                <a href="/deletebook/<%= book.id %>"><button class="action-btn delete">Delete</button></a>
            </td>
        </tr>
        <% }) %>
    </table>

    <footer>© 2025 Bookstore Management System</footer>
</body>
</html>