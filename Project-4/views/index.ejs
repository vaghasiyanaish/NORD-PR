<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Bookstore Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", sans-serif;
        }

        body {
            background: #eef1f7;
            padding: 25px;
            min-height: 100vh;
        }

        header {
            background: #4e73df;
            padding: 25px;
            text-align: center;
            color: #fff;
            font-size: 2.4rem;
            font-weight: 700;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            margin-bottom: 45px;
        }

        .form-container {
            max-width: 900px;
            margin: auto;
            background: #fff;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        }

        .form-container h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #4e73df;
            font-size: 1.8rem;
            font-weight: 700;
        }

        label {
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
            color: #333;
        }

        input, textarea {
            width: 100%;
            padding: 14px;
            border-radius: 10px;
            border: 2px solid #d1d3e2;
            margin-bottom: 18px;
            font-size: 1rem;
            transition: .3s;
        }

        input:focus, textarea:focus {
            border-color: #4e73df;
            box-shadow: 0 0 6px rgba(78,115,223,0.4);
            outline: none;
        }

        textarea {
            height: 110px;
        }

        .btn {
            width: 100%;
            padding: 14px;
            margin-top: 10px;
            background: #1cc88a;
            color: #fff;
            font-weight: 700;
            font-size: 1.1rem;
            border-radius: 10px;
            cursor: pointer;
            border: none;
            transition: .3s;
        }

        .btn:hover {
            background: #17a673;
        }

        .list-table {
            width: 96%;
            margin: 60px auto;
            background: #fff;
            border-radius: 20px;
            border-collapse: collapse;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        }

        .list-table th {
            background: #4e73df;
            color: #fff;
            padding: 15px;
            font-size: 1rem;
            letter-spacing: .5px;
        }

        .list-table td {
            padding: 16px;
            border-bottom: 1px solid #e5e7eb;
            font-size: .95rem;
        }

        .list-table tr:hover {
            background: #f7f9fc;
        }

        .edit, .delete {
            padding: 10px 16px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            transition: .3s;
        }

        .edit {
            background: #4e73df;
            color: #fff;
        }

        .edit:hover {
            background: #3959b8;
        }

        .delete {
            background: #e74a3b;
            color: #fff;
        }

        .delete:hover {
            background: #c23321;
        }

        footer {
            margin-top: 60px;
            text-align: center;
            padding: 18px;
            color: #666;
        }
    </style>
</head>
<body>

<header><i class="fas fa-book-open"></i> Bookstore Management</header>

<div class="form-container">
    <h2>Add New Book</h2>

    <form action="/add-book" method="post">

        <label>Title</label>
        <input type="text" name="title" required />

        <label>Author</label>
        <input type="text" name="author" required />

        <label>Genre</label>
        <input type="text" name="genre" required />

        <label>Price</label>
        <input type="number" name="price" required />

        <label>Description</label>
        <textarea name="description" required></textarea>

        <label>Publisher</label>
        <input type="text" name="publisher" required />

        <label>Published Year</label>
        <input type="number" name="year" required />

        <button class="btn">Add Book <i class="fas fa-plus"></i></button>
    </form>
</div>

<table class="list-table">
    <tr>
        <th>#</th>
        <th>Book</th>
        <th>Author</th>
        <th>Genre</th>
        <th>Price</th>
        <th>Description</th>
        <th>Publisher</th>
        <th>Year</th>
        <th>Action</th>
    </tr>

    <% books.forEach((book, index)=> { %>
        <tr>
            <td><%= index + 1 %></td>
            <td><%= book.title %></td>
            <td><%= book.author %></td>
            <td><%= book.genre %></td>
            <td>₹<%= book.price.toFixed(2) %></td>
            <td><%= book.description %></td>
            <td><%= book.publisher %></td>
            <td><%= book.year %></td>
            <td>
                <a href="/editbook/<%= book.id %>"><button class="edit">Edit</button></a>
                <a href="/deletebook/<%= book.id %>"><button class="delete">Delete</button></a>
            </td>
        </tr>
    <% }) %>
</table>

<footer>© 2025 Bookstore Management System</footer>

</body>
</html>