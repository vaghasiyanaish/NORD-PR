<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Edit Book</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", sans-serif;
        }

        body {
            background: #f0f4ff;
            min-height: 100vh;
            padding: 20px;
        }

        header {
            background: #4e73df;
            padding: 25px;
            text-align: center;
            font-size: 2.2rem;
            font-weight: 700;
            color: white;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            margin-bottom: 40px;
        }

        .form-container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        label {
            font-weight: 600;
            color: #3a3a3a;
            margin-bottom: 8px;
            display: block;
        }

        input,
        textarea {
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: 2px solid #d1d3e2;
            transition: 0.3s ease;
            margin-bottom: 22px;
            font-size: 1rem;
        }

        input:focus,
        textarea:focus {
            border-color: #4e73df;
            box-shadow: 0 0 6px rgba(78, 115, 223, 0.4);
            outline: none;
        }

        textarea {
            height: 120px;
        }

        .btn-row {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }

        .btn {
            flex: 1;
            padding: 14px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            border: none;
            transition: 0.3s;
        }

        .update-btn {
            background: #1cc88a;
            color: white;
        }

        .update-btn:hover {
            background: #17a673;
        }

        .back-btn {
            background: #858796;
            color: white;
            text-align: center;
            text-decoration: none;
            padding-top: 14px;
            display: block;
        }

        .back-btn:hover {
            background: #5a5c69;
        }

        footer {
            margin-top: 60px;
            text-align: center;
            color: #777;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>

    <header>✏ Edit Book</header>

    <div class="form-container">
        <form action="/edit/<%= book.id %>" method="post">

            <label>Title</label>
            <input type="text" name="title" value="<%= book.title %>" required />

            <label>Author</label>
            <input type="text" name="author" value="<%= book.author %>" required />

            <label>Genre</label>
            <input type="text" name="genre" value="<%= book.genre %>" required />

            <label>Price</label>
            <input type="number" name="price" value="<%= book.price %>" required />

            <label>Description</label>
            <textarea name="description" required><%= book.description %></textarea>

            <label>Publisher</label>
            <input type="text" name="publisher" value="<%= book.publisher %>" required />

            <label>Year</label>
            <input type="number" name="year" value="<%= book.year %>" required />

            <div class="btn-row">
                <a href="/" class="btn back-btn"><i class="fas fa-arrow-left"></i> Back</a>
                <button type="submit" class="btn update-btn"><i class="fas fa-save"></i> Update</button>
            </div>

        </form>
    </div>

    <footer>
        © 2025 Bookstore Management System
    </footer>

</body>

</html>
