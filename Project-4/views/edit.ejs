<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Book - Neo Theme</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", sans-serif;
        }

        body {
            background: linear-gradient(135deg, #ffe8d6, #fcd2af);
            min-height: 100vh;
            color: #3a2e2a;
        }

        header {
            background: #6a040f;
            padding: 25px;
            text-align: center;
            font-size: 2.5rem;
            font-weight: 700;
            color: white;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        }

        .form-container {
            margin: 50px auto;
            max-width: 900px;
            padding: 35px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
        }

        .form-title {
            text-align: center;
            font-size: 1.9rem;
            margin-bottom: 20px;
            color: #6a040f;
            font-weight: 700;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .form-group label {
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
            color: #5b4636;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: 1px solid #c5b5a1;
            background: #fff7f0;
            font-size: 1rem;
            transition: .3s;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #9d0208;
            background: #ffffff;
            box-shadow: 0 0 8px rgba(157, 2, 8, 0.3);
            outline: none;
        }

        textarea {
            height: 150px;
            resize: none;
        }

        .btn-row {
            display: flex;
            gap: 20px;
            margin-top: 30px;
        }

        .btn {
            flex: 1;
            padding: 15px;
            text-align: center;
            font-size: 1.1rem;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 700;
            transition: .3s;
            color: white;
        }

        .update-btn {
            background: #9d0208;
        }
        .update-btn:hover {
            background: #780000;
            transform: translateY(-2px);
        }

        .back-btn {
            background: #3d3d3d;
        }
        .back-btn:hover {
            background: #222;
            transform: translateY(-2px);
        }

        footer {
            margin-top: 60px;
            background: #6a040f;
            color: white;
            text-align: center;
            padding: 18px;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

<header><i class="fas fa-pen"></i> Edit Book</header>

<div class="form-container">
    <h2 class="form-title">Update Book Details</h2>

    <form action="/edit/<%= book.id %>" method="post">

        <div class="form-grid">
            <div class="form-group">
                <label>Title</label>
                <input type="text" name="title" value="<%= book.title %>" required>
            </div>

            <div class="form-group">
                <label>Author</label>
                <input type="text" name="author" value="<%= book.author %>" required>
            </div>

            <div class="form-group">
                <label>Genre</label>
                <input type="text" name="genre" value="<%= book.genre %>" required>
            </div>

            <div class="form-group">
                <label>Price</label>
                <input type="number" name="price" value="<%= book.price %>" required>
            </div>
        </div>

        <div class="form-group" style="margin-top:20px;">
            <label>Description</label>
            <textarea name="description" required><%= book.description %></textarea>
        </div>

        <div class="form-grid" style="margin-top:20px;">
            <div class="form-group">
                <label>Publisher</label>
                <input type="text" name="publisher" value="<%= book.publisher %>" required>
            </div>

            <div class="form-group">
                <label>Year</label>
                <input type="number" name="year" value="<%= book.year %>" required>
            </div>
        </div>

        <div class="btn-row">
            <a href="/" class="btn back-btn"><i class="fas fa-arrow-left"></i> Back</a>
            <button type="submit" class="btn update-btn"><i class="fas fa-save"></i> Update</button>
        </div>

    </form>
</div>

<footer>© 2025 Bookstore Management System</footer>

</body>
</html>
